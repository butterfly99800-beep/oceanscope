# MySQL connection for Prisma.
# Copy this file to .env and replace the values with your own local MySQL credentials.
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/oceanscope"

# NEXT_PUBLIC_APP_NAME=OceanScope

# Auth.js / NextAuth settings. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Seed-only passwords. Do not use these sample values in production.
SEED_ADMIN_PASSWORD="change-me-before-production"
SEED_CUSTOMER_PASSWORD="change-me-before-production"

# COSCO schedule scraper test. Disabled by default for safety.
COSCO_SCRAPER_ENABLED="false"
COSCO_SCRAPER_HEADLESS="true"
COSCO_SCRAPER_TIMEOUT_MS="60000"

# Hide seed schedules from default frontend/admin schedule queries when false.
SHOW_SEED_SCHEDULES="true"
