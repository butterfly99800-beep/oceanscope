# MySQL connection for Prisma.
# Copy this file to .env and replace the values with your own local MySQL credentials.
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/oceanscope"

# NEXT_PUBLIC_APP_NAME=OceanScope

# Auth.js / NextAuth settings. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Seed-only passwords. Do not use these sample values in production.
SEED_ADMIN_PASSWORD="change-me-before-production"
SEED_CUSTOMER_PASSWORD="change-me-before-production"

# COSCO schedule scraper test. Disabled by default for safety.
SCHEDULE_LIVE_FETCH_ENABLED="false"
COSCO_SCRAPER_ENABLED="false"
COSCO_SCRAPER_HEADLESS="true"
COSCO_SCRAPER_TIMEOUT_MS="60000"
COSCO_SCHEDULE_CACHE_MINUTES="360"
COSCO_SCHEDULE_FETCH_COOLDOWN_SECONDS="120"
# Frontend mode: "api" is fast; "auto" uses the public Edge form on API 403.
# Frontend browser/edge settings also use API first. Automatic browsers are always headless.
COSCO_FRONTEND_SCRAPER_MODE="auto"
# Keep this false for normal frontend use. When true, "auto" may run Playwright fallback.
COSCO_FRONTEND_BROWSER_FALLBACK="true"

# CMA CGM and OOCL use public pages; Hapag falls back to its public page.
# MSC calls the public website API directly (no API key or login).
# On Windows Chrome/Edge is auto-detected. Set this only when the browser is elsewhere.
SCHEDULE_BROWSER_EXECUTABLE_PATH=""
# Automatic browser fallbacks are headless; install Chromium on Ubuntu.
SCHEDULE_BROWSER_HEADLESS="true"
SCHEDULE_PROVIDER_TIMEOUT_MS="75000"
CMA_PUBLIC_SCHEDULE_URL="https://www.cma-cgm.com/ebusiness/schedules"

# Hapag-Lloyd public, no-login schedule endpoint (x-token: public).
HAPAG_SCHEDULE_API_URL="https://schedule.api.hlag.cloud/api/routes"

# Hide seed schedules from default frontend/admin schedule queries when false.
SHOW_SEED_SCHEDULES="false"

# Optional MAERSK website client key. Supply privately; never commit its value.
MAERSK_CONSUMER_KEY=""
# Explicit opt-in for a brand-new empty database only.
OCEANSCOPE_DATABASE_MODE=""
# Explicit one-time administrator creation; existing accounts are never updated.
OCEANSCOPE_INIT_ADMIN="false"
INIT_ADMIN_EMAIL=""
INIT_ADMIN_PASSWORD=""
# Reviewed CSV must be provisioned separately; no developer machine paths.
PORTS_DATA_FILE="data/ports.csv"
OCEANSCOPE_IMPORT_PORTS="false"
