generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

model Port {
  id                 String             @id @default(cuid())
  name               String
  nameZh             String?
  locode             String             @unique
  country            String
  countryCode        String?
  region             String
  latitude           Float?
  longitude          Float?
  status             RecordStatus       @default(ACTIVE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  originRoutes       Route[]            @relation("RouteOriginPort")
  destinationRoutes  Route[]            @relation("RouteDestinationPort")
  transitRouteLinks  RouteTransitPort[]
  originSchedules      SailingSchedule[]  @relation("ScheduleOriginPort")
  destinationSchedules SailingSchedule[]  @relation("ScheduleDestinationPort")
  scheduleTransitLinks ScheduleTransitPort[]
  scheduleRouteNodes   ScheduleRouteNode[]
  originRateQuotes     RateQuote[]        @relation("RateOriginPort")
  destinationRateQuotes RateQuote[]       @relation("RateDestinationPort")
  originBookingOrders   BookingOrder[]     @relation("BookingOriginPort")
  destinationBookingOrders BookingOrder[]   @relation("BookingDestinationPort")

  @@index([country])
  @@index([region])
  @@index([status])
}

model Carrier {
  id        String       @id @default(cuid())
  name      String
  nameZh    String?
  code      String       @unique
  country   String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  routes    Route[]
  schedules SailingSchedule[]
  rateQuotes RateQuote[]
  bookingOrders BookingOrder[]

  @@index([country])
  @@index([status])
}

model Route {
  id                   String             @id @default(cuid())
  name                 String
  serviceName          String
  carrierId            String
  originPortId         String
  destinationPortId    String
  direct               Boolean            @default(false)
  averageTransitDays   Int
  status               RecordStatus       @default(ACTIVE)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  carrier              Carrier            @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  originPort           Port               @relation("RouteOriginPort", fields: [originPortId], references: [id], onDelete: Restrict)
  destinationPort      Port               @relation("RouteDestinationPort", fields: [destinationPortId], references: [id], onDelete: Restrict)
  transitPorts         RouteTransitPort[]
  schedules            SailingSchedule[]
  rateQuotes           RateQuote[]
  bookingOrders        BookingOrder[]

  @@index([carrierId])
  @@index([originPortId])
  @@index([destinationPortId])
  @@index([status])
}

model RouteTransitPort {
  id        String   @id @default(cuid())
  routeId   String
  portId    String
  sequence  Int
  createdAt DateTime @default(now())
  route     Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  port      Port     @relation(fields: [portId], references: [id], onDelete: Restrict)

  @@unique([routeId, sequence])
  @@unique([routeId, portId])
  @@index([portId])
}

enum ScheduleStatus {
  NORMAL
  EXPECTED_DELAY
  DELAYED
  CUTOFF_SOON
  CANCELLED
}

enum ScheduleNodeType {
  ORIGIN
  TRANSIT
  DESTINATION
}

model SailingSchedule {
  id                   String                @id @default(cuid())
  carrierId            String
  routeId              String?
  serviceName          String
  routeName            String
  vesselName           String                @db.VarChar(80)
  voyageNumber         String                @db.VarChar(40)
  originPortId         String
  destinationPortId    String
  etd                  DateTime
  eta                  DateTime
  transitDays          Int
  direct               Boolean               @default(false)
  stopCount            Int                   @default(0)
  frequency            String
  originTerminal       String
  destinationTerminal  String
  cyOpenTime           DateTime
  siCutOffTime         DateTime
  vgmCutOffTime        DateTime
  customsCutOffTime    DateTime
  estimatedBerthingTime DateTime
  departureReliability Int
  status               ScheduleStatus        @default(NORMAL)
  delayHours           Int                   @default(0)
  originalEtd          DateTime?
  originalEta          DateTime?
  lastUpdatedAt        DateTime              @default(now())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  carrier              Carrier               @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  route                Route?                @relation(fields: [routeId], references: [id], onDelete: SetNull)
  originPort           Port                  @relation("ScheduleOriginPort", fields: [originPortId], references: [id], onDelete: Restrict)
  destinationPort      Port                  @relation("ScheduleDestinationPort", fields: [destinationPortId], references: [id], onDelete: Restrict)
  transitPorts         ScheduleTransitPort[]
  routeNodes           ScheduleRouteNode[]

  @@unique([carrierId, vesselName, voyageNumber, originPortId, destinationPortId, etd])
  @@index([carrierId])
  @@index([routeId])
  @@index([originPortId])
  @@index([destinationPortId])
  @@index([etd])
  @@index([eta])
  @@index([status])
  @@index([vesselName])
  @@index([voyageNumber])
}

model ScheduleTransitPort {
  id            String          @id @default(cuid())
  scheduleId    String
  portId        String
  sequence      Int
  arrivalTime   DateTime
  departureTime DateTime
  waitingHours  Int
  vesselName    String?  @db.VarChar(80)
  voyageNumber  String?  @db.VarChar(40)
  terminal      String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  schedule      SailingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  port          Port            @relation(fields: [portId], references: [id], onDelete: Restrict)

  @@unique([scheduleId, sequence])
  @@unique([scheduleId, portId])
  @@index([portId])
}

model ScheduleRouteNode {
  id            String           @id @default(cuid())
  scheduleId    String
  portId        String
  sequence      Int
  nodeType      ScheduleNodeType
  arrivalTime   DateTime?
  departureTime DateTime?
  terminal      String?
  createdAt     DateTime         @default(now())
  schedule      SailingSchedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  port          Port             @relation(fields: [portId], references: [id], onDelete: Restrict)

  @@unique([scheduleId, sequence])
  @@index([portId])
}
enum RateStatus {
  ACTIVE
  EXPIRED
  INACTIVE
}

enum TransportMode {
  FCL
  LCL
  AIR
}

enum ContainerType {
  TWENTY_GP
  FORTY_GP
  FORTY_HC
  FORTY_FIVE_HC
}

enum RateChargeCategory {
  BASE
  ORIGIN
  DESTINATION
  SURCHARGE
  OPTIONAL
}

model RateQuote {
  id                      String          @id @default(cuid())
  carrierId               String
  routeId                 String?
  originPortId            String
  destinationPortId       String
  serviceName             String          @db.VarChar(80)
  transportMode           TransportMode   @default(FCL)
  containerType           ContainerType
  currency                String          @db.VarChar(3)
  baseFreight             Decimal         @db.Decimal(12, 2)
  fuelSurcharge           Decimal         @db.Decimal(12, 2)
  terminalHandlingCharge  Decimal         @db.Decimal(12, 2)
  documentationFee        Decimal         @db.Decimal(12, 2)
  bookingFee              Decimal         @db.Decimal(12, 2)
  dangerousGoodsSurcharge Decimal         @db.Decimal(12, 2) @default(0)
  otherSurcharge          Decimal         @db.Decimal(12, 2) @default(0)
  totalBasePrice          Decimal         @db.Decimal(12, 2)
  effectiveFrom           DateTime
  validUntil              DateTime
  transitDays             Int
  direct                  Boolean         @default(false)
  stopCount               Int             @default(0)
  vesselName              String          @db.VarChar(80)
  voyageNumber            String          @db.VarChar(40)
  etd                     DateTime
  eta                     DateTime
  cutOffDate              DateTime
  freeDays                Int             @default(7)
  reliability             Int
  status                  RateStatus      @default(ACTIVE)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  carrier                 Carrier         @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  route                   Route?          @relation(fields: [routeId], references: [id], onDelete: SetNull)
  originPort              Port            @relation("RateOriginPort", fields: [originPortId], references: [id], onDelete: Restrict)
  destinationPort         Port            @relation("RateDestinationPort", fields: [destinationPortId], references: [id], onDelete: Restrict)
  lineItems               RateLineItem[]
  bookingOrders           BookingOrder[]

  @@unique([carrierId, originPortId, destinationPortId, serviceName, containerType, effectiveFrom, validUntil])
  @@index([carrierId])
  @@index([routeId])
  @@index([originPortId])
  @@index([destinationPortId])
  @@index([containerType])
  @@index([effectiveFrom])
  @@index([validUntil])
  @@index([status])
  @@index([etd])
  @@index([eta])
}

model RateLineItem {
  id          String             @id @default(cuid())
  rateQuoteId String
  category    RateChargeCategory
  code        String             @db.VarChar(40)
  name        String             @db.VarChar(120)
  description String?            @db.VarChar(255)
  unit        String             @db.VarChar(40)
  unitPrice   Decimal            @db.Decimal(12, 2)
  currency    String             @db.VarChar(3)
  required    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  rateQuote   RateQuote          @relation(fields: [rateQuoteId], references: [id], onDelete: Cascade)

  @@index([rateQuoteId])
  @@index([category])
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id           String         @id @default(cuid())
  name         String?        @db.VarChar(120)
  email        String         @unique @db.VarChar(160)
  passwordHash String         @db.VarChar(255)
  role         UserRole       @default(CUSTOMER)
  status       UserStatus     @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  lastLoginAt  DateTime?
  orders       BookingOrder[]
  timelineActions BookingTimeline[] @relation("BookingTimelineActor")

  @@index([role])
  @@index([status])
}

enum BookingStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  CANCELLED
  COMPLETED
}

model BookingOrder {
  id                String            @id @default(cuid())
  bookingNumber     String            @unique @db.VarChar(32)
  status            BookingStatus     @default(PENDING_CONFIRMATION)
  userId            String?
  customerName      String?           @db.VarChar(120)
  customerEmail     String?           @db.VarChar(160)
  customerPhone     String?           @db.VarChar(60)
  originPortId      String
  destinationPortId String
  carrierId         String
  routeId           String?
  rateQuoteId       String?
  serviceName       String            @db.VarChar(80)
  transportMode     TransportMode     @default(FCL)
  cargoType         String            @db.VarChar(40)
  readyDate         DateTime
  vesselName        String            @db.VarChar(80)
  voyageNumber      String            @db.VarChar(40)
  etd               DateTime
  eta               DateTime
  transitDays       Int
  stopCount         Int               @default(0)
  currency          String            @db.VarChar(3)
  subtotal          Decimal           @db.Decimal(12, 2)
  tax               Decimal           @db.Decimal(12, 2)
  total             Decimal           @db.Decimal(12, 2)
  quoteValidUntil   DateTime
  notes             String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  confirmedAt       DateTime?
  cancelledAt       DateTime?
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  originPort        Port              @relation("BookingOriginPort", fields: [originPortId], references: [id], onDelete: Restrict)
  destinationPort   Port              @relation("BookingDestinationPort", fields: [destinationPortId], references: [id], onDelete: Restrict)
  carrier           Carrier           @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  route             Route?            @relation(fields: [routeId], references: [id], onDelete: SetNull)
  rateQuote         RateQuote?        @relation(fields: [rateQuoteId], references: [id], onDelete: Restrict)
  containers        BookingContainer[]
  services          BookingService[]
  costItems         BookingCostItem[]
  timeline          BookingTimeline[]

  @@index([status])
  @@index([userId])
  @@index([originPortId])
  @@index([destinationPortId])
  @@index([carrierId])
  @@index([routeId])
  @@index([rateQuoteId])
  @@index([createdAt])
}

model BookingContainer {
  id            String        @id @default(cuid())
  orderId       String
  containerType ContainerType
  quantity      Int
  unitPrice     Decimal       @db.Decimal(12, 2)
  subtotal      Decimal       @db.Decimal(12, 2)
  createdAt     DateTime      @default(now())
  order         BookingOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model BookingService {
  id          String        @id @default(cuid())
  orderId     String
  code        String        @db.VarChar(60)
  name        String        @db.VarChar(120)
  description String?       @db.VarChar(255)
  quantity    Int
  unitPrice   Decimal       @db.Decimal(12, 2)
  subtotal    Decimal       @db.Decimal(12, 2)
  createdAt   DateTime      @default(now())
  order       BookingOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model BookingCostItem {
  id        String        @id @default(cuid())
  orderId   String
  category  String        @db.VarChar(80)
  code      String        @db.VarChar(60)
  name      String        @db.VarChar(120)
  quantity  Int
  unitPrice Decimal       @db.Decimal(12, 2)
  subtotal  Decimal       @db.Decimal(12, 2)
  currency  String        @db.VarChar(3)
  createdAt DateTime      @default(now())
  order     BookingOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model BookingTimeline {
  id          String        @id @default(cuid())
  orderId     String
  status      BookingStatus
  title       String        @db.VarChar(120)
  description String?       @db.VarChar(255)
  occurredAt  DateTime
  actorUserId String?
  actorName   String?       @db.VarChar(160)
  actorRole   UserRole?
  createdAt   DateTime      @default(now())
  order       BookingOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor       User?         @relation("BookingTimelineActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
  @@index([actorUserId])
}
